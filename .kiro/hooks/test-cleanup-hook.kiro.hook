{
  "enabled": true,
  "name": "Test File Cleanup",
  "description": "Automatically runs unit tests and other test files to ensure they pass, then deletes them from the codebase",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "test-*.js",
      "*test.js",
      "*.test.js",
      "**/*test*.js",
      "tests/**/*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "I need to run the test files that were just modified to ensure they pass, then delete them. First execute the test files using node or the appropriate test runner to verify they pass. If all tests pass successfully, delete the test files. If any tests fail, report the failures and do not delete the files. Focus on files matching patterns like test-*.js, *test.js, *.test.js and similar test file naming conventions."
  }
}