{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Automatically updates README.md files and all other documentation when source code files are modified to keep documentation in sync with implementation changes",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "src/**/*.js",
      "main.js",
      "main-new.js",
      "package.json",
      "*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code files have been updated. Please review the changes and update the relevant documentation files including README.md, guide files (*.md), and any other documentation to reflect the current state of the codebase. Focus on keeping API documentation, usage examples, and feature descriptions accurate and up-to-date."
  }
}