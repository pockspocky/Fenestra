{
  "logging": {
    "level": "debug",
    "modules": {
      "ActionCallbackSystem": "debug",
      "ConfigurationManager": "debug",
      "WindowManager": "debug"
    },
    "transports": [
      {
        "type": "console",
        "level": "debug",
        "format": "pretty",
        "options": {
          "colorize": true,
          "timestamp": true
        }
      },
      {
        "type": "file",
        "level": "debug",
        "format": "json",
        "options": {
          "filename": "logs/fenestra-dev.log",
          "maxSize": "10MB",
          "maxFiles": 5
        }
      }
    ]
  },
  "performanceMonitoring": {
    "thresholds": {
      "slow": 50,
      "warning": 200,
      "critical": 500
    }
  },
  "game": {
    "autoSaveInterval": 10000
  }
}