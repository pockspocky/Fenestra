  "_htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Welcome to Fenestra</title>\n  <style>\n    body {\n      margin: 0;\n      padding: 0;\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #1e1e1e;\n      color: #e0e0e0;\n    }\n    \n    .email-container {\n      max-width: 600px;\n      margin: 0 auto;\n      background-color: #1e1e1e;\n    }\n    \n    .welcome-banner {\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      padding: 40px 20px;\n      text-align: center;\n      color: white;\n      border-radius: 8px 8px 0 0;\n    }\n    \n    .logo-container {\n      margin-bottom: 20px;\n    }\n    \n    .logo-placeholder {\n      width: 120px;\n      height: 120px;\n      background-color: rgba(255, 255, 255, 0.2);\n      border-radius: 50%;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 48px;\n      font-weight: bold;\n    }\n    \n    .welcome-banner h1 {\n      margin: 0 0 10px 0;\n      font-size: 32px;\n      font-weight: 600;\n    }\n    \n    .welcome-banner p {\n      margin: 0;\n      font-size: 18px;\n      opacity: 0.9;\n    }\n    \n    .welcome-content {\n      padding: 30px 20px;\n      line-height: 1.6;\n    }\n    \n    .welcome-content h2 {\n      color: #667eea;\n      margin-top: 0;\n      margin-bottom: 15px;\n      font-size: 24px;\n    }\n    \n    .welcome-content h3 {\n      color: #8b9dc3;\n      margin-top: 25px;\n      margin-bottom: 12px;\n      font-size: 18px;\n    }\n    \n    .welcome-content p {\n      margin-bottom: 15px;\n      color: #c0c0c0;\n    }\n    \n    .welcome-content ul {\n      list-style: none;\n      padding-left: 0;\n    }\n    \n    .welcome-content li {\n      padding: 8px 0 8px 30px;\n      position: relative;\n      color: #c0c0c0;\n    }\n    \n    .welcome-content li:before {\n      content: \"✓\";\n      position: absolute;\n      left: 0;\n      color: #667eea;\n      font-weight: bold;\n      font-size: 18px;\n    }\n    \n    .cta-button {\n      display: inline-block;\n      padding: 14px 32px;\n      background-color: #4a9eff;\n      color: white;\n      text-decoration: none;\n      border-radius: 6px;\n      margin-top: 20px;\n      font-weight: 600;\n      transition: all 0.3s ease;\n      cursor: pointer;\n      border: none;\n      font-size: 16px;\n    }\n    \n    .cta-button:hover {\n      background-color: #3a8eef;\n      transform: translateY(-2px);\n      box-shadow: 0 4px 12px rgba(74, 158, 255, 0.4);\n    }\n    \n    .cta-button:active {\n      transform: translateY(0);\n    }\n    \n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n      gap: 15px;\n      margin: 25px 0;\n    }\n    \n    .feature-card {\n      background-color: #3a3a3a;\n      padding: 20px;\n      border-radius: 8px;\n      text-align: center;\n      transition: transform 0.2s ease;\n    }\n    \n    .feature-card:hover {\n      transform: scale(1.05);\n      background-color: #424242;\n    }\n    \n    .feature-icon {\n      font-size: 36px;\n      margin-bottom: 10px;\n    }\n    \n    .feature-title {\n      font-weight: 600;\n      color: #e0e0e0;\n      margin-bottom: 5px;\n    }\n    \n    .feature-desc {\n      font-size: 13px;\n      color: #a0a0a0;\n    }\n    \n    .footer {\n      padding: 20px;\n      text-align: center;\n      background-color: #1a1a1a;\n      color: #808080;\n      font-size: 12px;\n      border-radius: 0 0 8px 8px;\n    }\n    \n    .interactive-demo {\n      background-color: #3a3a3a;\n      padding: 20px;\n      border-radius: 8px;\n      margin: 20px 0;\n      border-left: 4px solid #667eea;\n    }\n    \n    .counter-display {\n      font-size: 24px;\n      font-weight: bold;\n      color: #667eea;\n      margin: 15px 0;\n    }\n    \n    .demo-buttons {\n      display: flex;\n      gap: 10px;\n      flex-wrap: wrap;\n    }\n    \n    .demo-button {\n      padding: 8px 16px;\n      background-color: #667eea;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 14px;\n      transition: background-color 0.2s ease;\n    }\n    \n    .demo-button:hover {\n      background-color: #5568d3;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <!-- Banner Section -->\n    <div class=\"welcome-banner\">\n      <div class=\"logo-container\">\n        <!-- Placeholder for logo image - can be replaced with: <img src=\"game-data/emails/templates/images/logo.png\" alt=\"Fenestra Logo\"> -->\n        <div class=\"logo-placeholder\">F</div>\n      </div>\n      <h1>Welcome to Fenestra!</h1>\n      <p>Your journey through windows begins now</p>\n    </div>\n    \n    <!-- Main Content -->\n    <div class=\"welcome-content\">\n      <h2>🎮 Getting Started</h2>\n      <p>Fenestra is a unique puzzle game where you'll explore mysteries through windows, doors, and keys. Navigate through an intricate world of interconnected spaces and uncover secrets hidden in plain sight.</p>\n      \n      <h3>What to Expect:</h3>\n      <ul>\n        <li>Challenging puzzles that test your observation skills</li>\n        <li>A rich story told through emails and discoveries</li>\n        <li>Hidden secrets waiting to be uncovered</li>\n        <li>Immersive environments with interactive elements</li>\n      </ul>\n      \n      <!-- Feature Grid -->\n      <div class=\"feature-grid\">\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">🔍</div>\n          <div class=\"feature-title\">Explore</div>\n          <div class=\"feature-desc\">Discover hidden clues</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">🧩</div>\n          <div class=\"feature-title\">Solve</div>\n          <div class=\"feature-desc\">Crack complex puzzles</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-icon\">📧</div>\n          <div class=\"feature-title\">Connect</div>\n          <div class=\"feature-desc\">Follow the story</div>\n        </div>\n      </div>\n      \n      <!-- Interactive Demo Section -->\n      <div class=\"interactive-demo\">\n        <h3 style=\"margin-top: 0;\">🎯 Interactive Demo</h3>\n        <p>This email demonstrates inline JavaScript functionality. Try clicking the buttons below:</p>\n        <div class=\"counter-display\" id=\"counter\">Counter: 0</div>\n        <div class=\"demo-buttons\">\n          <button class=\"demo-button\" id=\"incrementBtn\">Increment</button>\n          <button class=\"demo-button\" id=\"decrementBtn\">Decrement</button>\n          <button class=\"demo-button\" id=\"resetBtn\">Reset</button>\n        </div>\n      </div>\n      \n      <p>Check your inbox regularly for hints, quests, and new challenges. Each email may contain important information about your next steps.</p>\n      \n      <div style=\"text-align: center;\">\n        <button class=\"cta-button\" id=\"startBtn\">Start Your Adventure</button>\n      </div>\n    </div>\n    \n    <!-- Footer -->\n    <div class=\"footer\">\n      <p>This is an automated message from the Fenestra System</p>\n      <p>© 2025 Fenestra Game | All rights reserved</p>\n    </div>\n  </div>\n  \n  <!-- Inline Scripts to demonstrate functionality -->\n  <script>\n    // Counter functionality\n    let counter = 0;\n    const counterDisplay = document.getElementById('counter');\n    const incrementBtn = document.getElementById('incrementBtn');\n    const decrementBtn = document.getElementById('decrementBtn');\n    const resetBtn = document.getElementById('resetBtn');\n    \n    function updateCounter() {\n      counterDisplay.textContent = `Counter: ${counter}`;\n      console.log('Counter updated:', counter);\n    }\n    \n    incrementBtn.addEventListener('click', () => {\n      counter++;\n      updateCounter();\n    });\n    \n    decrementBtn.addEventListener('click', () => {\n      counter--;\n      updateCounter();\n    });\n    \n    resetBtn.addEventListener('click', () => {\n      counter = 0;\n      updateCounter();\n      console.log('Counter reset');\n    });\n    \n    // Start adventure button\n    const startBtn = document.getElementById('startBtn');\n    startBtn.addEventListener('click', (e) => {\n      e.preventDefault();\n      console.log('Adventure started! This could trigger game events.');\n      \n      // Visual feedback\n      startBtn.textContent = '✓ Adventure Started!';\n      startBtn.style.backgroundColor = '#4caf50';\n      \n      setTimeout(() => {\n        startBtn.textContent = 'Start Your Adventure';\n        startBtn.style.backgroundColor = '#4a9eff';\n      }, 2000);\n      \n      // In a real implementation, this could trigger IPC calls to the main process\n      // Example: window.electronAPI?.startAdventure();\n    });\n    \n    // Feature card hover effects with console logging\n    const featureCards = document.querySelectorAll('.feature-card');\n    featureCards.forEach((card, index) => {\n      card.addEventListener('click', () => {\n        const title = card.querySelector('.feature-title').textContent;\n        console.log(`Feature card clicked: ${title}`);\n        \n        // Add a temporary highlight effect\n        card.style.backgroundColor = '#667eea';\n        setTimeout(() => {\n          card.style.backgroundColor = '#3a3a3a';\n        }, 300);\n      });\n    });\n    \n    // Log when the email is loaded\n    console.log('Welcome email template loaded successfully');\n    console.log('Template features: Interactive buttons, styled content, and event handlers');\n    \n    // Demonstrate that scripts can access and modify the DOM\n    document.addEventListener('DOMContentLoaded', () => {\n      console.log('DOM fully loaded and parsed');\n      console.log('Email container dimensions:', {\n        width: document.querySelector('.email-container').offsetWidth,\n        height: document.querySelector('.email-container').offsetHeight\n      });\n    });\n  </script>\n</body>\n</html>\n",
